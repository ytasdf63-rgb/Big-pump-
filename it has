<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Telegram Multiplayer Game</title>
  <style>
    body {
      font-family: system-ui, Segoe UI, Roboto, sans-serif;
      margin: 0;
      background: linear-gradient(135deg, #3a7bd5, #3a6073);
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      height: 100vh;
      padding: 20px;
    }

    h2 {
      margin-top: 20px;
    }

    #game {
      width: 360px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
      padding: 20px;
      text-align: center;
      margin-top: 20px;
    }

    input {
      padding: 8px;
      border: none;
      border-radius: 8px;
      margin: 4px;
    }

    button {
      background: #ffca28;
      border: none;
      border-radius: 8px;
      padding: 10px 16px;
      margin: 6px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s;
    }

    button:hover {
      background: #ffd54f;
    }

    #log {
      background: rgba(0,0,0,0.3);
      border-radius: 8px;
      margin-top: 12px;
      padding: 8px;
      font-size: 0.9em;
      height: 150px;
      overflow-y: auto;
      text-align: left;
    }

    #controls {
      margin-top: 12px;
    }

    #status {
      font-weight: bold;
      margin-bottom: 8px;
    }
  </style>
</head>
<body>
  <h2>Telegram Multiplayer Game 🎮</h2>
  <div id="game">
    <div id="status">Connecting...</div>

    <div id="join-area">
      <input id="name" placeholder="Your name" />
      <input id="room" placeholder="Room ID (optional)" />
      <button id="join">Join Room</button>
      <button id="create">Create Room</button>
    </div>

    <div id="controls" style="display:none;">
      <button id="hit">🔥 Hit!</button>
      <div id="score"></div>
    </div>

    <div id="log"></div>
  </div>

  <!-- Load Socket.IO -->
  <script src="/socket.io/socket.io.js"></script>

  <script>
    const socket = io();

    const statusEl = document.getElementById('status');
    const logEl = document.getElementById('log');
    const nameInput = document.getElementById('name');
    const roomInput = document.getElementById('room');
    const joinBtn = document.getElementById('join');
    const createBtn = document.getElementById('create');
    const controls = document.getElementById('controls');
    const hitBtn = document.getElementById('hit');
    const scoreEl = document.getElementById('score');

    let score = 0;

    const log = (msg) => {
      const line = document.createElement('div');
      line.textContent = new Date().toLocaleTimeString() + ' — ' + msg;
      logEl.prepend(line);
    };

    socket.on('connect', () => {
      statusEl.textContent = '✅ Connected';
      log('Connected to server.');
    });

    socket.on('roomUpdate', data => {
      log('Players in room: ' + data.players);
    });

    socket.on('startGame', data => {
      log('Game started! ' + (data.msg || ''));
      controls.style.display = 'block';
    });

    socket.on('playerMove', data => {
      log('Opponent move: ' + JSON.stringify(data.move));
      if (data.move.type === 'hit') {
        score -= data.move.power;
        scoreEl.textContent = 'Score: ' + score;
      }
    });

    joinBtn.onclick = () => {
      let room = roomInput.value || new URLSearchParams(location.search).get('room');
      if (!room) {
        alert('Enter or provide a room ID.');
        return;
      }
      const name = nameInput.value || 'Player';
      socket.emit('joinRoom', { roomId: room, name });
      log('Joining room ' + room);
      statusEl.textContent = 'Joined room: ' + room;
    };

    createBtn.onclick = () => {
      window.location.href = '/create';
    };

    hitBtn.onclick = () => {
      const move = { type: 'hit', power: Math.floor(Math.random() * 10) + 1 };
      socket.emit('playerMove', move);
      log('You hit with power ' + move.power);
      score += move.power;
      scoreEl.textContent = 'Score: ' + score;
    };

    // Auto-join if ?room= in URL
    const urlRoom = new URLSearchParams(location.search).get('room');
    if (urlRoom) {
      roomInput.value = urlRoom;
    }
  </script>
</body>
</html>
